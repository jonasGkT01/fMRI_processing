configfile: "config/config.yaml"

include: "rules/extract_parcels.smk"
include: "rules/compute_isc.smk"
include: "rules/plot_isc.smk"

from pathlib import Path
from itertools import product

SUBJECTS = [f"{i:03d}" for i in range(config["subjects"]["start"], config["subjects"]["end"] + 1)]

def run_label(run_tag):
    return "norun" if run_tag == "" else run_tag.replace("_", "")

# Discover valid inputs
BOLD_FILES = []
for subject, task, run_tag, space, resolution, descriptor in product(
    SUBJECTS,
    config["tasks"],
    config["run_tags"],
    config["spaces"],
    config["resolutions"],
    config["descriptors"],
):
    bold_file = config["bold_glob_pattern"].format(
        subject=subject,
        task=task,
        run_tag=run_tag,
        space=space,
        resolution=resolution,
        descriptor=descriptor,
    )
    if Path(bold_file).exists():
        BOLD_FILES.append({
            "subject": subject,
            "task": task,
            "run_tag": run_tag,
            "run_label": run_label(run_tag),
            "space": space,
            "resolution": resolution,
            "descriptor": descriptor,
            "bold_file": bold_file,
        })

print(f"Found {len(BOLD_FILES)} valid BOLD file(s)")

# Group by task only
TASK_GROUPS = {}
for c in BOLD_FILES:
    TASK_GROUPS.setdefault(c["task"], []).append(c)

print(f"Found {len(TASK_GROUPS)} task group(s)")

PARCEL_OUTPUTS = [
    f"../results/parcels/{c['task']}/sub-{c['subject']}_task-{c['task']}_{run_label(c['run_tag'])}_space-{c['space']}_res-{c['resolution']}_desc-{c['descriptor']}_parcel_ts.npy"
    for c in BOLD_FILES
]

ISC_NPY_OUTPUTS = [
    f"../results/isc/task-{task}_isc_mean.npy"
    for task in TASK_GROUPS
]

ISC_NII_OUTPUTS = [
    f"../results/isc/task-{task}_isc_mean.nii.gz"
    for task in TASK_GROUPS
]

FIG_PNG_OUTPUTS = [
    f"../results/figures/task-{task}_isc_mean.png"
    for task in TASK_GROUPS
]

FIG_HTML_OUTPUTS = [
    f"../results/figures/task-{task}_isc_mean.html"
    for task in TASK_GROUPS
]

rule all:
    input:
        PARCEL_OUTPUTS,
        ISC_NPY_OUTPUTS,
        ISC_NII_OUTPUTS,
        FIG_PNG_OUTPUTS,
        FIG_HTML_OUTPUTS